# Copy to .env. Never commit .env, never put these in browser code.

# Which Lightning backend: nwc | phoenixd | fake
LN_BACKEND=nwc

# NWC: a RECEIVE-ONLY connection (make_invoice + lookup_invoice) from your wallet
# (Alby Hub, Coinos, LNbits...). The server refuses connections that can spend.
MERCHANT_NWC_URL=

# Only for the free test faucet, whose wallets always have full permissions.
# Never set this with a real wallet.
ALLOW_SPEND_PERMISSIONS=0

# phoenixd: use the limited-access password, which can't send payments
PHOENIXD_URL=http://127.0.0.1:9740
PHOENIXD_PASSWORD=

# Shop settings
SHOP_NAME=Yaba Thrift Corner
PORT=8787
# Price lock / invoice expiry in seconds
INVOICE_EXPIRY_SECONDS=600

# Demo only: a test buyer wallet so judges can try the happy path in one click
DEMO_MODE=0
BUYER_TEST_NWC_URL=
