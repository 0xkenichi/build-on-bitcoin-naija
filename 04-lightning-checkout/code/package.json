{
  "name": "naija-checkout",
  "version": "0.1.0",
  "private": true,
  "description": "Modules 4-5 of Build on Bitcoin, Naija: a drop-in Lightning checkout with naira prices, QR, WebLN/NWC and receipts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "demo": "npm run build && tsx src/demo/server.ts",
    "selftest": "tsx --test test/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "pay": "tsx scripts/pay.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@getalby/sdk": "9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "qrcode-generator": "^1.4.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
